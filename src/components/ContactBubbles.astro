---
const phone = '+380994527949';
const phoneDigits = '380994527949';
---

<div class="contact-bubbles" id="contactBubbles">
  <button type="button" class="caption" id="bubblesCaption">
    <span class="caption-close" aria-hidden="true">×</span>
    <span class="caption-text">
      Є питання? Хочете замовити насіння?<br />Пишіть, телефонуйте!
    </span>
  </button>

  <div class="stack">
    <a class="bubble phone-bubble" href={`tel:${phone}`} aria-label="Зателефонувати">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
    </a>
    <a class="bubble tg-bubble" href={`https://t.me/+${phoneDigits}`} target="_blank" rel="noopener" aria-label="Написати у Telegram">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="#fff" aria-hidden="true">
        <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212-.07-.062-.174-.041-.249-.024-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
      </svg>
    </a>
    <a class="bubble vb-bubble" href={`https://msng.link/o/?${phoneDigits}=vi`} target="_blank" rel="noopener" aria-label="Написати у Viber">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
      </svg>
    </a>
  </div>
</div>

<style>
  .contact-bubbles {
    position: fixed; right: 24px; bottom: 24px; z-index: 100;
    display: flex; flex-direction: column; align-items: flex-end; gap: 12px;
  }

  .caption {
    display: flex; align-items: center; gap: 8px;
    background: #fff; color: var(--ink);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px 14px;
    box-shadow: 0 8px 22px rgba(20,20,20,.14);
    font-size: 0.85rem;
    line-height: 1.4;
    text-align: left;
    cursor: pointer;
  }
  .caption-text { font-weight: 600; }
  .caption-close {
    font-size: 1.1rem; line-height: 1; color: var(--muted);
    flex-shrink: 0;
  }
  .caption-close:hover { color: var(--ink); }

  .stack { display: flex; flex-direction: column; gap: 14px; align-items: center; }
  .bubble {
    width: 56px; height: 56px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 6px 22px rgba(0,0,0,.22);
    transition: transform .15s;
  }
  .bubble:hover { transform: scale(1.08); }
  .phone-bubble { background: var(--blue); }
  .tg-bubble { background: #29a9eb; }
  .vb-bubble { background: #7360f2; }

  body.bubbles-dismissed .caption { display: none; }

  @media (max-width: 640px) {
    .contact-bubbles { right: 16px; bottom: 16px; gap: 10px; }
    .bubble { width: 50px; height: 50px; }
    .caption { max-width: 220px; font-size: 0.8rem; padding: 8px 12px; }
  }
</style>

<script>
  const caption = document.getElementById('bubblesCaption');
  caption?.addEventListener('click', () => {
    document.body.classList.add('bubbles-dismissed');
  });
</script>
