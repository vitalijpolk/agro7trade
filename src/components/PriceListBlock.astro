---
import { findPriceTable, formatPrice, PRICE_LIST_PDF, PRICE_LIST_UPDATED } from '../data/price-list';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const table = findPriceTable(slug);
const isCorn = table?.crop === 'kukurudza';
const metaCols = isCorn ? ['ФАО'] : ['Вегетація, днів', 'Вовчок'];
const cols = table ? 1 + metaCols.length + table.tiers.length : 0;
const title = table ? table.title.charAt(0).toLowerCase() + table.title.slice(1) : '';
---

{table && (
  <section class="price-list" id="prais">
    <div class="pl-head">
      <div>
        <h2>Прайс: {title}</h2>
        <p class="pl-sub">Ціни за посівну одиницю, грн. Оновлено {PRICE_LIST_UPDATED}.</p>
      </div>
      <div class="pl-actions">
        <a class="pl-btn" href={PRICE_LIST_PDF} target="_blank" rel="noopener">Відкрити прайс (PDF)</a>
        <a class="pl-link" href={PRICE_LIST_PDF} download="Прайс Agro7Trade 2026.pdf">Завантажити</a>
      </div>
    </div>

    <div class="pl-scroll">
      <table>
        <thead>
          <tr>
            <th>Гібрид</th>
            {metaCols.map((c) => <th>{c}</th>)}
            {table.tiers.map((t) => <th class="pl-num">{t}</th>)}
          </tr>
        </thead>
        <tbody>
          {table.groups.map((g) => (
            <>
              {g.title && <tr class="pl-group"><td colspan={cols}>{g.title}</td></tr>}
              {g.rows.map((r) => (
                <tr class={r.slug === slug ? 'pl-current' : undefined}>
                  <td class="pl-name">
                    {r.slug === slug ? <strong>{r.name}</strong> : <a href={`/product/${r.slug}/`}>{r.name}</a>}
                    {r.note && <span class="pl-note">{r.note}</span>}
                  </td>
                  {isCorn ? <td>{r.fao}</td> : <><td>{r.vegetation ?? '—'}</td><td>{r.broomrape ?? '—'}</td></>}
                  {r.cells.map((c) =>
                    c.kind === 'covered' ? null
                    : c.kind === 'merged' ? <td class="pl-num pl-merged" rowspan={c.rowspan}>{formatPrice(c.value)}</td>
                    : c.kind === 'single' ? <td class="pl-num pl-single" colspan={c.colspan}>{formatPrice(c.value)}</td>
                    : <td class="pl-num">{formatPrice(c.value)}</td>,
                  )}
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
    </div>
    <p class="pl-pack">{table.packaging}</p>
  </section>
)}

<style>
  .price-list { margin-top: 56px; border: 1px solid var(--border); border-radius: 14px; padding: 24px 24px 20px; background: #fff; }
  .pl-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }
  .pl-head h2 { font-size: 1.2rem; }
  .pl-sub { margin-top: 6px; color: var(--muted); font-size: 0.88rem; }
  .pl-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .pl-btn { background: var(--blue); color: #fff; font-weight: 700; padding: 10px 18px; border-radius: 9px; font-size: 0.92rem; }
  .pl-btn:hover { background: var(--blue-deep); }
  .pl-link { color: var(--blue-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; font-size: 0.9rem; }
  .pl-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; font-size: 0.94rem; min-width: 460px; }
  th, td { padding: 10px 12px; border-bottom: 1px solid var(--border); text-align: left; }
  thead th { color: var(--muted); font-weight: 600; font-size: 0.85rem; background: var(--panel); white-space: nowrap; }
  .pl-num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pl-group td { background: var(--panel-hov); color: var(--blue-deep); font-weight: 700; font-size: 0.85rem; }
  .pl-name { white-space: nowrap; }
  .pl-name a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 3px; }
  .pl-name a:hover { color: var(--blue-deep); }
  .pl-note { margin-left: 8px; color: var(--muted); font-size: 0.8rem; }
  .pl-single { text-align: center; }
  .pl-merged { text-align: center; vertical-align: middle; font-weight: 700; background: var(--panel); }
  .pl-current td { background: #eef3fe; font-weight: 700; }
  .pl-current td:first-child { box-shadow: inset 3px 0 0 var(--blue); }
  .pl-pack { margin-top: 14px; padding: 10px 14px; background: var(--panel); border-radius: 8px; color: var(--text); font-size: 0.88rem; line-height: 1.5; }
  @media (max-width: 600px) {
    .price-list { padding: 18px 14px 14px; }
    th, td { padding: 9px 8px; }
  }
</style>
