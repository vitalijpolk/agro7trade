---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' });

const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const postUrl = `${siteUrl}/blog/${post.id}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  url: postUrl,
  mainEntityOfPage: postUrl,
  inLanguage: 'uk-UA',
  author: { '@type': 'Organization', name: 'Agro7Trade' },
  publisher: {
    '@type': 'Organization',
    name: 'Agro7Trade',
    logo: { '@type': 'ImageObject', url: `${siteUrl}/favicon.png` },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Головна', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Блог', item: `${siteUrl}/blog/` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: postUrl },
  ],
};

const faqSchema = post.data.faq && post.data.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<BaseLayout title={`${post.data.title} — Agro7Trade`} description={post.data.excerpt} type="article">
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <article class="post">
    <div class="container narrow">
      <a href="/blog" class="back">← Усі статті</a>
      <p class="meta">{dateFmt.format(post.data.date)} · {post.data.readMinutes} хв читання</p>
      <h1>{post.data.title}</h1>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post { padding: 56px 0 96px; }
  .narrow { max-width: 720px; }
  .back {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 28px;
  }
  .back:hover { color: var(--blue-deep); }
  .meta { font-size: 0.88rem; color: var(--muted); font-weight: 600; }
  h1 {
    margin-top: 12px;
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);
  }

  .prose {
    margin-top: 40px;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--ink);
  }
  .prose :global(h2) {
    font-size: 1.4rem;
    margin-top: 44px;
    margin-bottom: 16px;
  }
  .prose :global(p) { margin-bottom: 20px; }
  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 8px 0 28px;
    display: block;
  }
  .prose :global(ul), .prose :global(ol) {
    margin: 0 0 20px 0;
    padding-left: 1.3em;
  }
  .prose :global(ul) { list-style: disc; }
  .prose :global(ol) { list-style: decimal; }
  .prose :global(li) { margin-bottom: 8px; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(a) {
    color: var(--blue-deep);
    text-decoration: underline;
    text-decoration-color: var(--blue);
    text-underline-offset: 3px;
  }
</style>
