---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HybridCard from '../../components/HybridCard.astro';
import { cornImg, sunflowerImg } from '../../lib/images';
import { cropLabels, getHybridsByCrop, type Crop } from '../../data/hybrids';

export function getStaticPaths() {
  return (['kukurudza', 'sonyashnyk'] as Crop[]).map((crop) => ({ params: { crop } }));
}

const { crop } = Astro.params as { crop: Crop };
const items = getHybridsByCrop(crop);
const label = cropLabels[crop];
const image = crop === 'kukurudza' ? cornImg : sunflowerImg;

const copy = {
  kukurudza: {
    title: 'Купити насіння кукурудзи — гібриди ФАО 270–350 | Agro7Trade',
    description:
      'Купити насіння кукурудзи від Agro7Trade: гібриди ФАО 270–350 зернового напряму з високою посухостійкістю та холодостійкістю. Ціни, характеристики, доставка по Україні.',
    h1: 'Купити насіння кукурудзи',
    lead: 'Сертифіковані гібриди кукурудзи ФАО 270–350 зернового напряму — з повними характеристиками, реальними цінами та підбором під ваш регіон.',
    seoHeading: 'Насіння кукурудзи в Agro7Trade',
    seoParagraphs: [
      'Купити насіння кукурудзи в Agro7Trade можна поштучно або партією з доставкою по всій Україні. У каталозі — середньостиглі гібриди зернового напряму групи ФАО 270–350, які показують стабільний результат як у Степу, так і в Лісостепу за умови достатнього агрофону.',
      'Кожен гібрид у каталозі має повну специфікацію: висоту рослин, кількість рядів і зерен у качані, стійкість до посухи, вилягання та фузаріозу, а також рекомендовану густоту посіву окремо для посушливої зони, зони нестійкого та достатнього зволоження. Це дозволяє підібрати насіння кукурудзи під конкретне поле, а не орієнтуватись лише на назву гібрида.',
    ],
    links: [
      { href: '/blog/yak-obraty-gibryd-kukurudzy-za-shkaloyu-fao/', label: 'Як обрати гібрид кукурудзи за шкалою ФАО' },
      { href: '/blog/koly-zbyraty-kukurudzu-ta-sonyashnyk-oznaky-styglosti/', label: 'Коли збирати кукурудзу та соняшник' },
    ],
  },
  sonyashnyk: {
    title: 'Купити насіння соняшника — гібриди Гранстар, Clearfield | Agro7Trade',
    description:
      'Купити насіння соняшника від Agro7Trade: гібриди під технології Гранстар, Clearfield та класичну, олійність до 53%. Ціни, характеристики, доставка по Україні.',
    h1: 'Купити насіння соняшника',
    lead: 'Гібриди соняшника під технології Гранстар, Clearfield та класичну — з реальними показниками олійності, врожайності та стійкості до вовчка.',
    seoHeading: 'Насіння соняшника в Agro7Trade',
    seoParagraphs: [
      'Купити насіння соняшника в Agro7Trade можна під будь-яку технологію захисту — Гранстар (ExpressSun/SUMO), Clearfield (Євролайтнінг) або класичну без гербіцидної прив\'язки. У каталозі — гібриди з олійністю від 48% до 53% і стійкістю до вовчка соняшникового рас A–G.',
      'На сторінці кожного гібрида вказано реальний вегетаційний період, рекомендовану густоту посіву для Лісостепу та Степу, потенціал і середню врожайність, а також бали стійкості до основних хвороб — фомозу, фомопсису, іржі та білої гнилі. Це дозволяє порівняти гібриди між собою і купити насіння соняшника, яке підходить саме під вашу технологію та зону вирощування.',
    ],
    links: [
      { href: '/blog/koly-siyaty-sonyashnyk-stroky-ta-temperatura-gruntu/', label: 'Коли сіяти соняшник: строки та температура ґрунту' },
      { href: '/blog/koly-zbyraty-kukurudzu-ta-sonyashnyk-oznaky-styglosti/', label: 'Коли збирати кукурудзу та соняшник' },
    ],
  },
} as const;

const c = copy[crop];
const siteUrl = Astro.site!.toString().replace(/\/$/, '');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Головна', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Каталог', item: `${siteUrl}/catalog/` },
    { '@type': 'ListItem', position: 3, name: label.title, item: `${siteUrl}/catalog/${crop}/` },
  ],
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: items.map((h, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteUrl}/product/${h.slug}/`,
    name: h.title,
  })),
};
---

<BaseLayout title={c.title} description={c.description}>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>

  <section class="wrap page-head">
    <nav class="breadcrumbs" aria-label="Хлібні крихти">
      <a href="/">Головна</a>
      <span>/</span>
      <a href="/catalog">Каталог</a>
      <span>/</span>
      <span aria-current="page">{label.title}</span>
    </nav>
    <h1>{c.h1}</h1>
    <p class="lead">{c.lead}</p>
  </section>

  <section class="wrap grid-section">
    <div class="grid">
      {items.map((h) => (
        <HybridCard hybrid={h} image={image} />
      ))}
    </div>
  </section>

  <section class="wrap seo-section">
    <h2>{c.seoHeading}</h2>
    {c.seoParagraphs.map((p) => <p>{p}</p>)}
    <p class="reading-links">
      Читайте також:
      {c.links.map((l, i) => (
        <>
          {i > 0 && ', '}
          <a href={l.href}>{l.label}</a>
        </>
      ))}
      .
    </p>
  </section>
</BaseLayout>

<style>
  .wrap { max-width: var(--container); margin: 0 auto; padding: 0 var(--gutter); }
  .page-head { padding: 40px 0 8px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 0.85rem; color: var(--muted); }
  .breadcrumbs a { color: var(--muted); }
  .breadcrumbs a:hover { color: var(--blue-deep); }
  .breadcrumbs span[aria-current] { color: var(--ink); font-weight: 600; }
  h1 { margin-top: 14px; font-size: clamp(2rem, 3.6vw, 2.6rem); }
  .lead { margin-top: 14px; color: var(--muted); max-width: 56ch; }

  .grid-section { padding: 40px 0 60px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }

  .seo-section { padding: 0 0 80px; max-width: 760px; }
  .seo-section h2 { font-size: 1.3rem; margin-bottom: 16px; }
  .seo-section p { color: var(--muted); line-height: 1.7; margin-bottom: 14px; }
  .reading-links { font-size: 0.92rem; }
  .reading-links a { color: var(--blue-deep); font-weight: 600; }
</style>
