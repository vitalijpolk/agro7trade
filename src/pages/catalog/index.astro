---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { cornCategoryImg, sunflowerCategoryImg } from '../../lib/images';
import { cropLabels, getHybridsByCrop } from '../../data/hybrids';

const cropCards = [
  { crop: 'kukurudza' as const, image: cornCategoryImg, desc: 'Гібриди ФАО 270–350 зернового напряму, для різних зон вирощування.' },
  { crop: 'sonyashnyk' as const, image: sunflowerCategoryImg, desc: 'Гібриди під технології Гранстар, Clearfield та класичну, з повними специфікаціями.' },
];

const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Головна', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Каталог', item: `${siteUrl}/catalog/` },
  ],
};
---

<BaseLayout
  title="Каталог насіння — купити кукурудзу та соняшник | Agro7Trade"
  description="Купити насіння кукурудзи та соняшника від Agro7Trade — сертифіковані гібриди з перевіреними характеристиками та реальними цінами. Оберіть культуру."
>
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="wrap page-head">
    <nav class="breadcrumbs" aria-label="Хлібні крихти">
      <a href="/">Головна</a>
      <span>/</span>
      <span aria-current="page">Каталог</span>
    </nav>
    <h1>Каталог насіння</h1>
    <p class="lead">Оберіть культуру, щоб купити насіння з повними характеристиками та цінами.</p>
  </section>

  <section class="wrap crop-grid">
    {cropCards.map((c) => (
      <a class="crop-card" href={`/catalog/${c.crop}/`}>
        <div class="photo">
          <Image src={c.image} alt={cropLabels[c.crop].title} width={720} height={480} densities={[1, 2]} />
        </div>
        <div class="info">
          <h2>{cropLabels[c.crop].title}</h2>
          <p>{c.desc}</p>
          <span class="count">{getHybridsByCrop(c.crop).length} гібриди в каталозі</span>
        </div>
      </a>
    ))}
  </section>
</BaseLayout>

<style>
  .wrap { max-width: var(--container); margin: 0 auto; padding: 0 var(--gutter); }
  .page-head { padding-top: 40px; padding-bottom: 8px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 0.85rem; color: var(--muted); }
  .breadcrumbs a { color: var(--muted); }
  .breadcrumbs a:hover { color: var(--blue-deep); }
  .breadcrumbs span[aria-current] { color: var(--ink); font-weight: 600; }
  h1 { margin-top: 14px; font-size: clamp(2rem, 3.6vw, 2.6rem); }
  .lead { margin-top: 14px; color: var(--muted); max-width: 56ch; }

  .crop-grid {
    padding-top: 40px;
    padding-bottom: 80px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .crop-card {
    display: flex; flex-direction: column;
    background: #fff; border: 1px solid var(--border); border-radius: 16px; overflow: hidden;
    box-shadow: 0 2px 8px rgba(20,20,20,.05);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .crop-card:hover { transform: translateY(-3px); box-shadow: 0 14px 26px rgba(20,20,20,.1); }
  .photo { background: var(--panel); aspect-ratio: 3/2; overflow: hidden; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .info { padding: 22px 24px 26px; }
  .info h2 { font-size: 1.3rem; margin-bottom: 8px; }
  .info p { color: var(--muted); font-size: 0.94rem; line-height: 1.5; }
  .count { display: inline-block; margin-top: 14px; font-size: 0.85rem; font-weight: 700; color: var(--blue-deep); }

  @media (max-width: 700px) {
    .crop-grid { grid-template-columns: 1fr; }
  }
</style>
